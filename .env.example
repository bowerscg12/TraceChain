# Copy to .env and fill in. .env is gitignored; never commit real values.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=tracechain
PGUSER=tracechain
PGPASSWORD=change-me
# Superuser password chosen during the unattended PostgreSQL install (used only by db/reset.js to recreate the database)
PG_SUPERUSER_PASSWORD=change-me
API_PORT=3000
RPC_URL=http://127.0.0.1:8545
# Producer allowlist: Hardhat default local test accounts #1 and #2 (public, test-only; never real keys)
PRODUCER_ALLOWLIST=0x70997970C51812dc3A010C7d01b50e0d17dc79C8,0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC
